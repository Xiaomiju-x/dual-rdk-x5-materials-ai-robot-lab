{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaomiju.xyz/schemas/rb-voe/experiment-case-v1",
  "title": "ExperimentCase.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "sample_id", "lineage_sha256",
    "evidence_root_sha256", "allowed_options", "required_failure_atoms",
    "closure_predicate_id", "release_id", "created_at_ms"
  ],
  "properties": {
    "schema_version": {"const": "xrd-rb-voe-experiment-case-v1"},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "lineage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_options": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": [
        "E_VERIFY_IDENTITY", "E_VERIFY_RUNTIME", "E_XRD_SAME_HOLDER",
        "E_PL_CROSSCHECK", "E_REPREP_XRD", "E_BLINDED_ASSAY", "E_QUARANTINE"
      ]}
    },
    "required_failure_atoms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": [
        "SAMPLE_IDENTITY_UNRESOLVED", "XRD_PEAK_ALIASING",
        "PREPARATION_HETEROGENEITY_SUSPECTED", "CORRELATED_EVIDENCE_DOUBLE_COUNTED",
        "BPU_RUNTIME_UNQUALIFIED", "TRANSPORT_CAPABILITY_STALE", "GRIND_MACRO_NOT_ELIGIBLE"
      ]}
    },
    "closure_predicate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at_ms": {"type": "integer", "minimum": 0}
  }
}
