{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaomiju.xyz/schemas/rb-voe/assay-bootstrap/source-record.v1.schema.json",
  "title": "RB-VoE assay bootstrap source record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "evidence_tier",
    "modality",
    "source_type",
    "status",
    "title",
    "independence_group",
    "limitations",
    "local_path",
    "content_sha256",
    "byte_count",
    "url",
    "doi",
    "license_id",
    "redistributable",
    "metadata",
    "physical_denominator_increment"
  ],
  "properties": {
    "schema_version": {"const": "xrd-rb-voe-assay-bootstrap-source-v1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$"},
    "evidence_tier": {
      "enum": [
        "LITERATURE_RAG_PRIOR",
        "STRUCTURED_PUBLIC_REFERENCE",
        "DIGITIZED_FIGURE",
        "SEALED_REAL_RAW_REPLAY",
        "PHYSICS_SIMULATED_CHALLENGE"
      ]
    },
    "modality": {"enum": ["KNOWLEDGE", "XRD", "PL", "MIXED"]},
    "source_type": {"type": "string", "minLength": 1, "maxLength": 512},
    "status": {"enum": ["INDEX_ONLY", "LOCAL_HASHED", "CATALOG_ONLY"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "independence_group": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "local_path": {"type": ["string", "null"]},
    "content_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "byte_count": {"type": ["integer", "null"], "minimum": 0},
    "url": {"type": ["string", "null"], "maxLength": 2048},
    "doi": {"type": ["string", "null"], "maxLength": 256},
    "license_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "redistributable": {"type": "boolean"},
    "metadata": {"type": "object"},
    "physical_denominator_increment": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "LOCAL_HASHED"}}},
      "then": {
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "content_sha256": {"$ref": "#/$defs/sha256"},
          "byte_count": {"type": "integer", "minimum": 0}
        }
      },
      "else": {
        "properties": {
          "local_path": {"type": "null"},
          "content_sha256": {"type": "null"},
          "byte_count": {"type": "null"}
        }
      }
    }
  ]
}
