{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xrd.local/schemas/icmat-rag-hit.v1.schema.json",
  "title": "ICMat RAG Hit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "namespace",
    "chunk_id",
    "rank",
    "score",
    "retrieval_methods",
    "source_id",
    "source_title",
    "source_uri",
    "locator",
    "evidence_kind",
    "excerpt",
    "content_sha256"
  ],
  "properties": {
    "schema": {"const": "icmat.rag.hit.v1"},
    "namespace": {
      "enum": [
        "phosphor_xrd_pl",
        "electronic_materials_property",
        "fab_process_metrology_yield",
        "opto_packaging_reliability"
      ]
    },
    "chunk_id": {"type": "string", "pattern": "^icmch1:[0-9a-f]{64}$"},
    "rank": {"type": "integer", "minimum": 1},
    "score": {"type": "number"},
    "retrieval_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"},
    "source_title": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "evidence_kind": {
      "enum": [
        "literature_knowledge",
        "real_measurement",
        "structured_dataset",
        "source_metadata"
      ]
    },
    "excerpt": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
