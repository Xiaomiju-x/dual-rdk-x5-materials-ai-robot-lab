# Copy to .env locally. Never commit the populated file.
XRD_ENV=development
XRD_LOG_LEVEL=INFO

# Optional external services. Leave blank for offline use.
MATERIALS_API_KEY=
LLM_API_KEY=

# Optional Baidu speech integration. Keep blank to disable online ASR/TTS.
# Create new credentials after cloning; never reuse any value that appeared in Git history.
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Logical endpoints only. Do not commit real device addresses or identities.
AI_BRAIN_ENDPOINT=http://ai-brain.local:PORT
EMBODIED_BRAIN_ENDPOINT=http://embodied-brain.local:PORT
COMMAND_CENTER_ENDPOINT=http://localhost:PORT

# Hardware access must remain disabled for ordinary development and CI.
XRD_HARDWARE_ACCESS=disabled
XRD_MOTION_AUTHORITY=disabled
XRD_CAPTURE_ACCESS=disabled
