{
  "name": "workcockpit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WorkCockpit — premium real-time dashboard for the dual myCobot 280-Pi workstation, viewed on Xiaomi Pad.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview --host",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@vueuse/core": "^11.2.0",
    "@vueuse/motion": "^3.0.3",
    "echarts": "^6.1.0",
    "gsap": "^3.12.5",
    "motion-v": "^2.2.1",
    "pinia": "^2.2.6",
    "three": "^0.168.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.1.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^2.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "2.1.4",
    "glob": {
      "brace-expansion": "5.0.9"
