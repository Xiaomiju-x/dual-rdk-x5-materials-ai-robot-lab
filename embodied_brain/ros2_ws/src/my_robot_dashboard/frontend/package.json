{
  "name": "navcockpit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NavCockpit — premium real-time dashboard for embodied_brain, viewed on Xiaomi Pad.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext .vue,.ts,.tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css}\"",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@vueuse/core": "^11.2.0",
    "echarts": "^5.5.1",
    "gsap": "^3.12.5",
    "lottie-web": "^5.12.2",
    "pinia": "^2.2.6",
    "three": "^0.168.0",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.5.4",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.12.3"
}
